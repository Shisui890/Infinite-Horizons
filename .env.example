# ====================================================================
# INFINITE HORIZONS — CONFIGURAÇÃO DE AMBIENTE & OPENROUTER
# ====================================================================

# Chave de API do OpenRouter (obtenha em https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modelo padrão do OpenRouter para simulações temporais e pesquisa física
# Exemplo: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Endpoint do backend serverless (usado pelo frontend Vite)
VITE_AI_ENDPOINT=/api/temporal
VITE_AI_PROVIDER=custom_api

# Chave opcional caso queira fazer chamadas diretas pelo cliente (sem passar pela Vercel /api):
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Provedores alternativos legados (opcionais)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
