# Endpoint server-side recomendado para pesquisa historica e analise temporal.
# Nunca coloque chaves secretas em variaveis VITE_: elas ficam expostas no navegador.
# O endpoint serverless da Vercel protege as chaves do modelo.
VITE_AI_ENDPOINT=/api/temporal
VITE_AI_PROVIDER=custom_api

# Configure na Vercel, nunca no frontend:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ou Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
