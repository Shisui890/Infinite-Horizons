# ====================================================================
# INFINITE HORIZONS — CONFIGURAÇÃO DE AMBIENTE VITE & OPENROUTER
# ====================================================================

# Endpoint serverless / API para pesquisa histórica e simulação temporal
VITE_AI_ENDPOINT=/api/temporal
VITE_AI_PROVIDER=custom_api

# Se você quiser testar diretamente no frontend com a chave do OpenRouter:
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# No painel da Vercel (Project Settings > Environment Variables):
# OPENROUTER_API_KEY=sua_chave_do_openrouter_aqui
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENAI_API_KEY=
# OPENAI_MODEL=
